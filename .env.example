# LLM
DEEPSEEK_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# 工具（可选，不用 web_search 时留空）
TAVILY_API_KEY=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=ai_qa

# Redis（仅用于 React Web 登录会话与登录限流，不保存权威对话记忆）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 单用户演示认证（必须填入足够长的随机值，不要提交真实 token）
APP_ACCESS_TOKEN=
APP_USER_ID=default-user
# 本机单用户演示的启发式默认值：7 天；请按设备共享风险调整
APP_WEB_SESSION_TTL_SECONDS=604800
# 本机认证失败限制的启发式默认值：5 分钟内最多 10 次
APP_WEB_LOGIN_MAX_ATTEMPTS=10
APP_WEB_LOGIN_WINDOW_SECONDS=300

# 问答执行租约的启发式默认值：90 秒租约，每 30 秒续租；租约必须至少覆盖 3 个心跳周期
CHAT_TURN_LEASE_SECONDS=90
CHAT_TURN_HEARTBEAT_SECONDS=30
# 检索阶段总超时 / 流式阶段相邻对外进度事件的空闲超时（启发式默认值）
CHAT_STAGE_TIMEOUT_SECONDS=30

# MySQL 持久化索引任务（以下为单机启发式默认值，应根据任务耗时、失败率与积压调整）
INDEX_JOB_POLL_SECONDS=5
INDEX_JOB_LEASE_SECONDS=120
INDEX_JOB_BATCH_SIZE=20
INDEX_JOB_MAX_ATTEMPTS=10
INDEX_JOB_RETRY_BASE_SECONDS=30
INDEX_JOB_RETRY_MAX_SECONDS=1800

# 内部摘要调用默认最多等待 30 秒且不自动重试；失败时原始消息仍保留
SUMMARY_LLM_TIMEOUT_SECONDS=30
SUMMARY_LLM_MAX_RETRIES=0
# 动态资料字符预算；默认相对 DeepSeek V4 的 1M context 保守留出充足输出与估算误差空间
LLM_CONTEXT_MAX_CHARS=100000

# 前端访问地址与服务监听地址
API_URL=http://localhost:8000
API_HOST=127.0.0.1

# 路径
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
# 当前单机演示默认 25 MiB，可根据解析耗时和内存实测调整
MAX_UPLOAD_BYTES=26214400
