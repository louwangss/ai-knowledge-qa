# LLM
DEEPSEEK_API_KEY=sk-your-key-here

# 工具（可选，不用 web_search 时留空）
TAVILY_API_KEY=

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=ai_qa

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 单用户演示认证（必须填入足够长的随机值，不要提交真实 token）
APP_ACCESS_TOKEN=
APP_USER_ID=default-user
# 本机单用户演示的启发式默认值：7 天；请按设备共享风险调整
APP_WEB_SESSION_TTL_SECONDS=604800
# 本机认证失败限制的启发式默认值：5 分钟内最多 10 次
APP_WEB_LOGIN_MAX_ATTEMPTS=10
APP_WEB_LOGIN_WINDOW_SECONDS=300

# 前端访问地址与服务监听地址
API_URL=http://localhost:8000
API_HOST=127.0.0.1

# 路径
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
# 当前单机演示默认 25 MiB，可根据解析耗时和内存实测调整
MAX_UPLOAD_BYTES=26214400
